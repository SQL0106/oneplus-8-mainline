options="!check !archcheck"
depends="alsa-lib"

_commit="9e645da0ce76ccb7594d5b2da6fb43fe374b6897"
_repo="linux-oneplus-instantnoodle-$_commit"
source="$_repo.tar.gz::https://github.com/Xo666/linux-oneplus-instantnoodle/archive/$_commit/$_repo.tar.gz"
builddir="$srcdir/$_repo"

package() {
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/OnePlus"
	cp -a "$builddir/alsa-oneplus-instantnoodle/usr/share/alsa/ucm2/OnePlus/." "$pkgdir/usr/share/alsa/ucm2/OnePlus/"
}

